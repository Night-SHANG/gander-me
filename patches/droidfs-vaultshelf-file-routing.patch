+    private suspend fun performRecursiveSearch(query: String, rootPath: String) {
+        recycler_view_explorer.isVisible = false
+        loader.isVisible = true
+        textDirEmpty.isVisible = false
+
+        val pending = ArrayDeque<String>()
+        pending.add(rootPath)
+        val visited = HashSet<String>()
+        val matches = mutableListOf<ExplorerElement>()
+        var lastPublishMillis = System.currentTimeMillis()
+
+        while (pending.isNotEmpty()) {
+            yield()
+            val directory = pending.removeFirst()
+            if (!visited.add(directory)) continue
+            val children = withContext(Dispatchers.IO) {
+                encryptedVolume.readDir(directory)?.toList().orEmpty()
+            }
+            for (child in children) {
+                if (encryptedVolume !is SafVolume && child.fullPath == "/.vaultshelf") {
+                    continue
+                }
+                if (child.name.contains(query, ignoreCase = true)) {
+                    matches += child
+                }
+                if (child.isDirectory) {
+                    pending.addLast(child.fullPath)
+                }
+            }
+
+            val now = System.currentTimeMillis()
+            if (matches.isNotEmpty() && now - lastPublishMillis >= 350L) {
+                displaySearchResults(matches, query, rootPath, complete = false)
+                lastPublishMillis = now
+            }
+        }
+
+        displaySearchResults(matches, query, rootPath, complete = true)
+    }
