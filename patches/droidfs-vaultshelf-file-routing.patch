diff --git a/app/src/main/java/sushi/hardcore/droidfs/SettingsActivity.kt b/app/src/main/java/sushi/hardcore/droidfs/SettingsActivity.kt
--- a/app/src/main/java/sushi/hardcore/droidfs/SettingsActivity.kt
+++ b/app/src/main/java/sushi/hardcore/droidfs/SettingsActivity.kt
@@ -1,4 +1,23 @@
         override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
             setPreferencesFromResource(R.xml.root_preferences, rootKey)
             sharedPrefs = PreferenceManager.getDefaultSharedPreferences(requireContext())
+            val defaultVolumePreference =
+                findPreference<ListPreference>(Constants.DEFAULT_VOLUME_KEY)
+            val volumes = VolumeDatabase(requireContext()).use { it.getVolumes() }
+            val storedDefault = sharedPrefs.getString(Constants.DEFAULT_VOLUME_KEY, null)
+            val resolvedDefault = volumes.firstOrNull { it.uuid == storedDefault }
+                ?: volumes.firstOrNull { it.name == storedDefault }
+            when {
+                resolvedDefault != null && storedDefault != resolvedDefault.uuid ->
+                    sharedPrefs.edit().putString(Constants.DEFAULT_VOLUME_KEY, resolvedDefault.uuid).apply()
+                storedDefault != null && resolvedDefault == null ->
+                    sharedPrefs.edit().remove(Constants.DEFAULT_VOLUME_KEY).apply()
+            }
+            defaultVolumePreference?.apply {
+                entries = (listOf(getString(R.string.vaultshelf_default_volume_none)) +
+                    volumes.map { it.shortName }).toTypedArray()
+                entryValues = (listOf("") + volumes.map { it.uuid }).toTypedArray()
+                value = resolvedDefault?.uuid.orEmpty()
+                summaryProvider = ListPreference.SimpleSummaryProvider.getInstance()
+            }
             val colorPreference = findPreference<ListPreference>("color")

