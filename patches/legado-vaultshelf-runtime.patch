+            return
+        }
+        newConfigs.forEach { newConfig ->
+            val existingIndex = configList.indexOfFirst { it.themeName == newConfig.themeName }
+            if (existingIndex != -1) {
+                configList[existingIndex] = newConfig
+            } else {
+                configList.add(newConfig)
+            }
+        }
+        save()
