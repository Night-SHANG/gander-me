<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
        LocalLibraryRepository intentionally uses SharedPreferences.Editor.commit()
        because import/delete operations need the synchronous boolean result before
        reporting success. The KTX edit helper returns Unit and would remove that
        contract.
    -->
    <issue id="UseKtx">
        <ignore path="src/main/java/com/arjun/gander/library/LocalLibraryRepository.kt" />
        <!--
            TxtReaderActivity only persists a tiny local font-size preference with
            apply(); keeping the direct Android API here avoids pulling persistence
            style concerns into the reader UI. This exception is scoped to this file.
        -->
        <ignore path="src/main/java/com/arjun/gander/TxtReaderActivity.kt" />
    </issue>

    <!--
        Gander's custom audio transport intentionally includes Media3's rewind/forward
        controller layouts so PlayerControlView can supply the seek amount and matching
        controls. This was already an accepted baseline exception with Media3 1.5.1;
        Readium 3.1.2 resolves Media3 1.7.1 and changes only the version embedded in the
        lint message. Keep the existing exception scoped to this one legacy layout instead
        of weakening PrivateResource checks project-wide.
    -->
    <issue id="PrivateResource">
        <ignore path="src/main/res/layout/view_audio_controls.xml" />
    </issue>
</lint>
