<?xml version="1.0" encoding="utf-8"?>
<!--
     VaultShelf's View/XML palette mirrors the Compose Fluent palette so the mature
     Gander browser and viewer do not look like a different application when opened
     from the new shell. Role names stay unchanged to avoid rewriting the legacy UI.
-->
